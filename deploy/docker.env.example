# Settings of the Dockerized hub (deploy/docker-compose.yml). Copy to
# deploy/.env and set your own values; dash.example.com is a placeholder.
# Every other setting from the top-level .env.example (SMTP, Stripe,
# branding, ...) works here too.

# The hub's name. DNS: an A/AAAA record pointing at this server.
DASH_DOMAIN=dash.example.com
# Let's Encrypt account e-mail, for certificate expiry warnings.
ACME_EMAIL=you@example.com
# Defaults to https://$DASH_DOMAIN; set it if the hub is reached elsewhere.
# DASH_PUBLIC_URL=https://dash.example.com

# The first account (platform admin, owner of the "Default" org); see docs/users.md.
# An internet-facing hub refuses to start with a password under 16 characters or a
# known example such as change-me: use a random one (openssl rand -base64 24).
DASH_USERNAME=admin
DASH_PASSWORD=change-me

# Which image to run: pin a release (a version from the releases page, e.g. 1.2.0) and change it to upgrade.
# DASH_VERSION=latest
# Your own build or fork's image instead of the upstream one.
# DASH_IMAGE=ghcr.io/klahr/dash

# Daily database backups inside the data volume, the newest 7 kept (docs/deploy.md).
# Copy them off the server too: a backup in the same volume doesn't survive losing it.
DASH_BACKUP_DIR=/data/backups
# DASH_BACKUP_KEEP=7

# How many days the sign-in log keeps entries, with their IP addresses (0 = all).
# See docs/privacy.md.
# DASH_AUTH_LOG_DAYS=365

# Monitoring (docs/deploy.md#monitoring). JSON log lines for a log shipper
# reading `docker logs`, and Prometheus metrics on https://$DASH_DOMAIN/metrics
# for callers with this bearer token (`openssl rand -hex 24`).
# DASH_LOG_FORMAT=json
# DASH_METRICS_TOKEN=

# --- Wildcard certificates: live previews and org subdomains ---------------
# Both need Caddy with a DNS provider module (a DNS challenge). Without one,
# leave this section out: the hub itself works with plain Caddy.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dns.yml
# CADDY_DNS_PROVIDER=cloudflare
# CADDY_DNS_API_TOKEN=

# Live previews at https://<task>.<this domain>; DNS: *.preview.dash.example.com.
# DASH_PREVIEW_DOMAIN=preview.dash.example.com

# Org subdomains at https://<slug>.<this domain>; DNS: *.dash.example.com.
# DASH_ORG_DOMAIN=dash.example.com
