# Dash's hub as a systemd *user* service. The hub runs no claude, git or gh
# itself: tasks run on runners (dash runner, installed with dash runner install).
#
#   go build -o bin/dash ./cmd/dash
#   mkdir -p ~/.config/dash && cp .env.example ~/.config/dash/env
#   chmod 600 ~/.config/dash/env && $EDITOR ~/.config/dash/env
#   cp deploy/dash.service ~/.config/systemd/user/
#   loginctl enable-linger "$USER"    # keep running after logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now dash
#   journalctl --user -u dash -f
#
# After pulling changes: rebuild, then `systemctl --user restart dash`.
#
# Backups (docs/service.md): set DASH_BACKUP_DIR=backups in the env file for a
# daily copy of the database in ~/.local/share/dash/backups (newest 7 kept),
# or run `bin/dash backup ~/dash-backups/` any time, while Dash runs.
# To restore: stop the service, remove dash.db-wal and dash.db-shm, copy the
# backup over ~/.local/share/dash/dash.db, start it again.

[Unit]
Description=Dash hub (dashboard on :7788)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/github/klahr/dash
# Extra flags go here (-trust-proxy, -public-url, -name, -backup-dir ...).
# Secrets stay in the env file, not in this unit.
ExecStart=%h/dev/github/klahr/dash/bin/dash -env %h/.config/dash/env -trust-proxy

Restart=on-failure
RestartSec=3
# On SIGTERM, Dash waits up to 20s to shut down: give it that, and a little more.
TimeoutStopSec=30

[Install]
WantedBy=default.target
