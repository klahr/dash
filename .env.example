# Copy to .env and set your own values. .env is git-ignored.
# The first account (platform admin, owner of the "Default" org); see docs/users.md.
DASH_USERNAME=admin
DASH_PASSWORD=change-me
# DASH_PROJECTS=~/dev

# Optional: the same secret on every computer shown in one dashboard (see docs/several-computers.md).
# DASH_PEER_TOKEN=

# Optional: serve live previews of tasks at https://<task>.<this domain> (see docs/previews.md).
# DASH_PREVIEW_DOMAIN=preview.dash.example.com
