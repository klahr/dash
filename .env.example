# Copy to .env and set your own values. .env is git-ignored.
# The first account (platform admin, owner of the "Default" org); see docs/users.md.
DASH_USERNAME=admin
DASH_PASSWORD=change-me
# DASH_PROJECTS=~/dev

# Optional: the same secret on every computer shown in one dashboard (see docs/several-computers.md).
# DASH_PEER_TOKEN=

# Optional: serve live previews of tasks at https://<task>.<this domain> (see docs/previews.md).
# DASH_PREVIEW_DOMAIN=preview.dash.example.com

# Optional: email, for "forgot password" and open signup (see docs/signup.md).
# Links in emails point at DASH_PUBLIC_URL, which email needs.
# DASH_PUBLIC_URL=https://dash.example.com
# DASH_SMTP_HOST=smtp.example.com
# DASH_SMTP_PORT=587
# DASH_SMTP_USERNAME=dash@example.com
# DASH_SMTP_PASSWORD=
# DASH_SMTP_FROM="Dash <dash@example.com>"
# Let anyone create an account (off by default: invite-only).
# DASH_SIGNUP=1
