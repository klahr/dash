# Copy to .env and set your own values. .env is git-ignored.
# The first account (platform admin, owner of the "Default" org); see docs/users.md.
# With -public-url or -trust-proxy (internet-facing) Dash refuses to start with a password under
# 16 characters or a known example such as change-me: use a random one (openssl rand -base64 24).
DASH_USERNAME=admin
DASH_PASSWORD=change-me
# Where projects live. A runner also clones its hub's shared projects straight into it
# (<DASH_PROJECTS>/<repo>), or adopts a clone of the same repository already there.
# DASH_PROJECTS=~/dev

# Optional: serve live previews of tasks at https://<task>.<this domain> (see docs/previews.md).
# DASH_PREVIEW_DOMAIN=preview.dash.example.com

# Optional: org subdomains: each organization at https://<slug>.dash.example.com (off
# when unset; needs a wildcard DNS record and certificate, see docs/deploy.md).
# DASH_ORG_DOMAIN=dash.example.com
# Subdomains no org may take, replacing the defaults (comma-separated).
# DASH_ORG_RESERVED=www,api,admin,preview,status

# Optional: back up the database every day to this directory (relative to the data
# directory, ~/.local/share/dash), keeping the newest 7. See docs/service.md.
# DASH_BACKUP_DIR=backups
# DASH_BACKUP_KEEP=7
# DASH_BACKUP_EVERY=24h

# Optional: monitoring (see docs/deploy.md#monitoring). /healthz is always on.
# Logs as JSON lines for a log shipper, and the level to log at.
# DASH_LOG_FORMAT=json
# DASH_LOG_LEVEL=info
# Prometheus metrics on a listener of their own (loopback only without a token)...
# DASH_METRICS_ADDR=127.0.0.1:9090
# ...and/or on /metrics of the main listener, for callers sending this bearer token
# (16 or more characters, e.g. `openssl rand -hex 24`).
# DASH_METRICS_TOKEN=

# Optional: email, for "forgot password" and open signup (see docs/signup.md).
# Links in emails point at DASH_PUBLIC_URL, which email needs.
# DASH_PUBLIC_URL=https://dash.example.com
# DASH_SMTP_HOST=smtp.example.com
# DASH_SMTP_PORT=587
# DASH_SMTP_USERNAME=dash@example.com
# DASH_SMTP_PASSWORD=
# DASH_SMTP_FROM="Dash <dash@example.com>"
# Let anyone create an account (off by default: invite-only).
# DASH_SIGNUP=1

# Optional: bill organizations of two or more members per seat with Stripe
# (see docs/billing.md). Off unless set; needs DASH_PUBLIC_URL.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# DASH_BILLING_TRIAL_DAYS=14
# DASH_BILLING_GRACE=72h

# Branding and the landing page, for a hosted Dash (docs/branding.md).
# DASH_BRAND_NAME=Dash
# DASH_TERMS_URL=https://example.com/terms
# DASH_PRIVACY_URL=https://example.com/privacy
# DASH_CONTACT_EMAIL=help@example.com
# DASH_LOGO=/etc/dash/logo.svg
# Where the footer's "Source code" link points (AGPL): your fork if you changed Dash.
# DASH_SOURCE_URL=https://github.com/klahr/dash
# Show a landing page at / to visitors who aren't signed in (off by default).
# DASH_LANDING=1
# DASH_TEAM_PRICE="€8 per seat / month"
# DASH_PRICING_URL=https://example.com/pricing
